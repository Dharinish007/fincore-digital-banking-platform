-- =====================================================================
-- FinCore Digital Banking Platform — Loan Service Database Schema v2
-- Milestone 2: Loan Origination & Servicing (PostgreSQL)
--
-- Matches the FinCore Nexus milestone-2 requirements:
--   Loan Service | Origination workflow | Credit assessment |
--   EMI calculation | Disbursement | Collections
--
-- Runs against the SAME shared database as the account-service script
-- (fincore_database_postgres.sql):
--   spring.datasource.url=jdbc:postgresql://localhost:5432/BankingApp
--   spring.datasource.username=postgres
--   spring.datasource.password=1998
--
-- PREREQUISITE: run fincore_database_postgres.sql first (customers,
-- accounts tables must already exist).
--
-- SETUP:
--   psql -U postgres -d BankingApp -f fincore_loan_service_v2_postgres.sql
--
-- DESIGN NOTE: each of the 5 workflow stages gets its OWN table instead
-- of being flattened into a single loans.status column. This is what
-- lets you show "where is this loan in its lifecycle right now" and
-- keep a full history of every stage/assessment/disbursement/collection
-- event, instead of overwriting a single status field each time.
-- =====================================================================

-- ─────────────────────────────
-- 1. LOANS — core loan record
-- ─────────────────────────────
CREATE TABLE loans (
    loan_id            BIGSERIAL PRIMARY KEY,
    loan_reference      VARCHAR(30)    NOT NULL UNIQUE,   -- e.g. HL-2024-1247 (type prefix + year + seq)
    customer_id         BIGINT         NOT NULL,
    loan_type           VARCHAR(20)    NOT NULL,          -- HOME, PERSONAL, AUTO, EDUCATION, BUSINESS
    purpose             VARCHAR(40)    NOT NULL,
    principal_amount     DECIMAL(15,2)  NOT NULL,
    interest_rate        DECIMAL(5,2)   NOT NULL,          -- annual %
    tenure_months        INT            NOT NULL,
    application_date      TIMESTAMP      NOT NULL DEFAULT CURRENT_TIMESTAMP,
    loan_status          VARCHAR(20)    NOT NULL DEFAULT 'APPLIED',
    created_at            TIMESTAMP      NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at            TIMESTAMP      NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_loans_customer  FOREIGN KEY (customer_id) REFERENCES customers(customer_id),
    CONSTRAINT chk_loan_type      CHECK (loan_type IN ('HOME','PERSONAL','AUTO','EDUCATION','BUSINESS')),
    CONSTRAINT chk_loan_status    CHECK (loan_status IN ('APPLIED','IN_REVIEW','APPROVED','REJECTED','ACTIVE','CLOSED','DEFAULTED')),
    CONSTRAINT chk_principal_pos  CHECK (principal_amount > 0),
    CONSTRAINT chk_tenure_pos     CHECK (tenure_months > 0)
);

CREATE INDEX idx_loans_customer_status ON loans(customer_id, loan_status);
CREATE INDEX idx_loans_app_date        ON loans(application_date);

-- ─────────────────────────────
-- 2. LOAN ORIGINATION STAGES — origination workflow (one row per stage per loan)
-- ─────────────────────────────
CREATE TABLE loan_origination_stages (
    stage_id      BIGSERIAL PRIMARY KEY,
    loan_id        BIGINT         NOT NULL,
    stage_name     VARCHAR(30)    NOT NULL,   -- APPLICATION_RECEIVED, DOCUMENT_VERIFICATION, CREDIT_ASSESSMENT,
                                                -- UNDERWRITING_REVIEW, APPROVED, REJECTED, DISBURSED
    stage_status   VARCHAR(20)    NOT NULL DEFAULT 'PENDING',  -- PENDING, IN_PROGRESS, COMPLETED, FAILED
    started_at     TIMESTAMP      NOT NULL DEFAULT CURRENT_TIMESTAMP,
    completed_at   TIMESTAMP,
    remarks        VARCHAR(255),
    handled_by     VARCHAR(100),                                -- 'SYSTEM' or officer name

    CONSTRAINT fk_stage_loan     FOREIGN KEY (loan_id) REFERENCES loans(loan_id),
    CONSTRAINT chk_stage_name    CHECK (stage_name IN ('APPLICATION_RECEIVED','DOCUMENT_VERIFICATION','CREDIT_ASSESSMENT','UNDERWRITING_REVIEW','APPROVED','REJECTED','DISBURSED')),
    CONSTRAINT chk_stage_status  CHECK (stage_status IN ('PENDING','IN_PROGRESS','COMPLETED','FAILED'))
);

CREATE INDEX idx_stages_loan_id ON loan_origination_stages(loan_id);

-- ─────────────────────────────
-- 3. CREDIT ASSESSMENTS — credit assessment
-- ─────────────────────────────
CREATE TABLE credit_assessments (
    assessment_id     BIGSERIAL PRIMARY KEY,
    loan_id            BIGINT         NOT NULL,
    credit_score        INT            NOT NULL,    -- internal score, 300-900 scale
    cibil_score          INT            NOT NULL,    -- external bureau score, 300-900 scale
    annual_income        DECIMAL(15,2)  NOT NULL,
    dti_ratio            DECIMAL(5,2)   NOT NULL,    -- debt-to-income %
    employment_status    VARCHAR(20)    NOT NULL,
    risk_grade           VARCHAR(2)     NOT NULL,    -- A-E, derived from credit_score
    assessment_result     VARCHAR(20)    NOT NULL,   -- APPROVED, REJECTED, MANUAL_REVIEW
    assessed_at           TIMESTAMP      NOT NULL DEFAULT CURRENT_TIMESTAMP,
    assessed_by            VARCHAR(50)    NOT NULL DEFAULT 'SYSTEM',

    CONSTRAINT fk_assessment_loan   FOREIGN KEY (loan_id) REFERENCES loans(loan_id),
    CONSTRAINT chk_employment2      CHECK (employment_status IN ('SALARIED','SELF_EMPLOYED','BUSINESS_OWNER','UNEMPLOYED')),
    CONSTRAINT chk_grade2           CHECK (risk_grade IN ('A','B','C','D','E')),
    CONSTRAINT chk_assess_result    CHECK (assessment_result IN ('APPROVED','REJECTED','MANUAL_REVIEW')),
    CONSTRAINT chk_credit_score2    CHECK (credit_score BETWEEN 300 AND 900),
    CONSTRAINT chk_cibil_score      CHECK (cibil_score BETWEEN 300 AND 900)
);

CREATE INDEX idx_assessment_loan_id ON credit_assessments(loan_id);

-- ─────────────────────────────
-- 4. EMI SCHEDULE — EMI calculation (full amortization breakdown per installment)
-- ─────────────────────────────
CREATE TABLE emi_schedule (
    schedule_id            BIGSERIAL PRIMARY KEY,
    loan_id                  BIGINT         NOT NULL,
    installment_no           INT            NOT NULL,
    due_date                 DATE           NOT NULL,
    emi_amount                DECIMAL(15,2)  NOT NULL,
    principal_component       DECIMAL(15,2)  NOT NULL,
    interest_component        DECIMAL(15,2)  NOT NULL,
    outstanding_balance        DECIMAL(15,2)  NOT NULL,
    payment_status             VARCHAR(20)    NOT NULL DEFAULT 'PENDING', -- PAID, PENDING, OVERDUE, MISSED
    paid_amount                 DECIMAL(15,2)  NOT NULL DEFAULT 0.00,
    paid_date                   DATE,

    CONSTRAINT fk_schedule_loan     FOREIGN KEY (loan_id) REFERENCES loans(loan_id),
    CONSTRAINT chk_payment_status   CHECK (payment_status IN ('PAID','PENDING','OVERDUE','MISSED')),
    CONSTRAINT chk_emi_pos2         CHECK (emi_amount > 0),
    CONSTRAINT uq_loan_installment2 UNIQUE (loan_id, installment_no)
);

CREATE INDEX idx_schedule_loan_id  ON emi_schedule(loan_id);
CREATE INDEX idx_schedule_due_date ON emi_schedule(due_date);
CREATE INDEX idx_schedule_status   ON emi_schedule(payment_status);

-- ─────────────────────────────
-- 5. DISBURSEMENTS — disbursement (funds released to customer's account)
-- ─────────────────────────────
CREATE TABLE disbursements (
    disbursement_id      BIGSERIAL PRIMARY KEY,
    loan_id                BIGINT         NOT NULL,
    account_id              BIGINT         NOT NULL,   -- FK to accounts (where funds landed)
    disbursed_amount         DECIMAL(15,2)  NOT NULL,
    disbursement_date         TIMESTAMP      NOT NULL DEFAULT CURRENT_TIMESTAMP,
    disbursement_mode          VARCHAR(20)    NOT NULL DEFAULT 'FULL',  -- FULL, PARTIAL, TRANCHE
    reference_number             VARCHAR(30)    NOT NULL UNIQUE,          -- e.g. DSB-HL-2024-1247
    status                       VARCHAR(20)    NOT NULL DEFAULT 'INITIATED', -- INITIATED, COMPLETED, FAILED

    CONSTRAINT fk_disb_loan      FOREIGN KEY (loan_id) REFERENCES loans(loan_id),
    CONSTRAINT fk_disb_account   FOREIGN KEY (account_id) REFERENCES accounts(account_id),
    CONSTRAINT chk_disb_mode     CHECK (disbursement_mode IN ('FULL','PARTIAL','TRANCHE')),
    CONSTRAINT chk_disb_status   CHECK (status IN ('INITIATED','COMPLETED','FAILED')),
    CONSTRAINT chk_disb_amt_pos  CHECK (disbursed_amount > 0)
);

CREATE INDEX idx_disb_loan_id ON disbursements(loan_id);

-- ─────────────────────────────
-- 6. COLLECTIONS — collections (overdue installment follow-up tracking)
-- ─────────────────────────────
CREATE TABLE collections (
    collection_id          BIGSERIAL PRIMARY KEY,
    loan_id                  BIGINT         NOT NULL,
    schedule_id               BIGINT         NOT NULL,   -- FK to the overdue emi_schedule row
    overdue_days               INT            NOT NULL,
    collection_status           VARCHAR(20)    NOT NULL DEFAULT 'FOLLOWUP_SCHEDULED',
                                                -- FOLLOWUP_SCHEDULED, CONTACTED, PROMISE_TO_PAY, ESCALATED, WRITTEN_OFF, RESOLVED
    assigned_agent               VARCHAR(100),
    last_contact_date             TIMESTAMP,
    promise_to_pay_date            DATE,
    remarks                        VARCHAR(255),
    created_at                     TIMESTAMP      NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_collection_loan     FOREIGN KEY (loan_id) REFERENCES loans(loan_id),
    CONSTRAINT fk_collection_schedule FOREIGN KEY (schedule_id) REFERENCES emi_schedule(schedule_id),
    CONSTRAINT chk_collection_status  CHECK (collection_status IN ('FOLLOWUP_SCHEDULED','CONTACTED','PROMISE_TO_PAY','ESCALATED','WRITTEN_OFF','RESOLVED')),
    CONSTRAINT chk_overdue_nonneg     CHECK (overdue_days >= 0)
);

CREATE INDEX idx_collection_loan_id ON collections(loan_id);
CREATE INDEX idx_collection_status  ON collections(collection_status);

