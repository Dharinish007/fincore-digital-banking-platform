# Banking Service Fraud Detection, Settlement Engine and Notification Service Database

## MySQL Complete Database Schema

```sql
-- ============================================
-- Banking Service Management System
-- Notification Service Database
-- ============================================

CREATE DATABASE IF NOT EXISTS banking_services;

USE banking_services;

-- ============================================
-- 1. CUSTOMERS
-- ============================================

CREATE TABLE customers (
    customer_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    full_name VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE,
    phone_number VARCHAR(20) UNIQUE,
    account_number VARCHAR(30) UNIQUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================
-- 2. ACCOUNTS AND TRANSACTIONS
-- ============================================

CREATE TABLE accounts (
    account_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    customer_id BIGINT NOT NULL,
    account_number VARCHAR(30) NOT NULL UNIQUE,
    account_type ENUM('SAVINGS', 'CURRENT', 'LOAN') DEFAULT 'SAVINGS',
    balance DECIMAL(15,2) NOT NULL DEFAULT 0.00,
    status ENUM('ACTIVE', 'INACTIVE', 'BLOCKED', 'CLOSED') DEFAULT 'ACTIVE',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (customer_id) REFERENCES customers(customer_id)
        ON DELETE CASCADE
);

CREATE TABLE transactions (
    transaction_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    from_account_id BIGINT,
    to_account_id BIGINT,
    transaction_type ENUM('TRANSFER', 'DEPOSIT', 'WITHDRAWAL', 'PAYMENT') NOT NULL,
    amount DECIMAL(15,2) NOT NULL,
    transaction_status ENUM('PENDING', 'PROCESSING', 'SUCCESS', 'FAILED', 'BLOCKED', 'REVERSED') DEFAULT 'PENDING',
    transaction_reference VARCHAR(100) UNIQUE,
    transaction_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (from_account_id) REFERENCES accounts(account_id),
    FOREIGN KEY (to_account_id) REFERENCES accounts(account_id)
);

-- ============================================
-- 3. FRAUD DETECTION MODULE
-- ============================================

CREATE TABLE fraud_rules (
    rule_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    rule_name VARCHAR(150) NOT NULL,
    rule_type ENUM('AMOUNT_LIMIT', 'FREQUENCY', 'LOCATION', 'FAILED_ATTEMPTS', 'UNUSUAL_ACTIVITY') NOT NULL,
    threshold_value DECIMAL(15,2),
    risk_points INT NOT NULL DEFAULT 0,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE transaction_risk_scores (
    risk_score_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    transaction_id BIGINT NOT NULL UNIQUE,
    risk_score INT NOT NULL DEFAULT 0,
    risk_level ENUM('LOW', 'MEDIUM', 'HIGH', 'CRITICAL') DEFAULT 'LOW',
    decision ENUM('APPROVED', 'FLAGGED', 'BLOCKED') DEFAULT 'APPROVED',
    calculated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (transaction_id) REFERENCES transactions(transaction_id)
        ON DELETE CASCADE
);

CREATE TABLE fraud_alerts (
    fraud_alert_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    transaction_id BIGINT NOT NULL,
    customer_id BIGINT NOT NULL,
    rule_id BIGINT,
    risk_score INT NOT NULL,
    alert_reason VARCHAR(500) NOT NULL,
    status ENUM('OPEN', 'UNDER_REVIEW', 'CONFIRMED_FRAUD', 'FALSE_POSITIVE', 'RESOLVED') DEFAULT 'OPEN',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    resolved_at TIMESTAMP NULL,
    FOREIGN KEY (transaction_id) REFERENCES transactions(transaction_id),
    FOREIGN KEY (customer_id) REFERENCES customers(customer_id),
    FOREIGN KEY (rule_id) REFERENCES fraud_rules(rule_id)
);

CREATE TABLE blocked_transactions (
    block_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    transaction_id BIGINT NOT NULL UNIQUE,
    fraud_alert_id BIGINT,
    block_reason VARCHAR(500) NOT NULL,
    blocked_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (transaction_id) REFERENCES transactions(transaction_id)
        ON DELETE CASCADE,
    FOREIGN KEY (fraud_alert_id) REFERENCES fraud_alerts(fraud_alert_id)
        ON DELETE SET NULL
);

-- ============================================
-- 4. SETTLEMENT ENGINE
-- ============================================

CREATE TABLE settlement_batches (
    batch_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    batch_reference VARCHAR(100) NOT NULL UNIQUE,
    total_transactions INT DEFAULT 0,
    total_amount DECIMAL(15,2) DEFAULT 0.00,
    status ENUM('PENDING', 'PROCESSING', 'SETTLED', 'PARTIALLY_SETTLED', 'FAILED') DEFAULT 'PENDING',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    settled_at TIMESTAMP NULL
);

CREATE TABLE settlement_transactions (
    settlement_transaction_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    batch_id BIGINT NOT NULL,
    transaction_id BIGINT NOT NULL UNIQUE,
    settlement_amount DECIMAL(15,2) NOT NULL,
    status ENUM('PENDING', 'PROCESSING', 'SETTLED', 'FAILED', 'REVERSED') DEFAULT 'PENDING',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    settled_at TIMESTAMP NULL,
    FOREIGN KEY (batch_id) REFERENCES settlement_batches(batch_id)
        ON DELETE CASCADE,
    FOREIGN KEY (transaction_id) REFERENCES transactions(transaction_id)
        ON DELETE CASCADE
);

CREATE TABLE settlement_reconciliation (
    reconciliation_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    settlement_transaction_id BIGINT NOT NULL,
    expected_amount DECIMAL(15,2) NOT NULL,
    settled_amount DECIMAL(15,2) NOT NULL,
    difference_amount DECIMAL(15,2) NOT NULL DEFAULT 0.00,
    status ENUM('MATCHED', 'MISMATCH', 'PENDING_REVIEW') DEFAULT 'PENDING_REVIEW',
    reconciled_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (settlement_transaction_id)
        REFERENCES settlement_transactions(settlement_transaction_id)
        ON DELETE CASCADE
);

-- ============================================
-- 5. NOTIFICATION PREFERENCES
-- Stores customer notification settings
-- ============================================

CREATE TABLE notification_preferences (
    preference_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    customer_id BIGINT NOT NULL,

    email_enabled BOOLEAN DEFAULT TRUE,
    sms_enabled BOOLEAN DEFAULT TRUE,
    push_enabled BOOLEAN DEFAULT TRUE,

    transaction_alerts BOOLEAN DEFAULT TRUE,
    security_alerts BOOLEAN DEFAULT TRUE,
    fraud_alerts BOOLEAN DEFAULT TRUE,
    emi_alerts BOOLEAN DEFAULT TRUE,

    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    FOREIGN KEY (customer_id)
        REFERENCES customers(customer_id)
        ON DELETE CASCADE
);

-- ============================================
-- 6. NOTIFICATION TEMPLATES
-- Stores reusable notification messages
-- ============================================

CREATE TABLE notification_templates (
    template_id BIGINT AUTO_INCREMENT PRIMARY KEY,

    notification_type VARCHAR(50) NOT NULL,
    channel ENUM('EMAIL', 'SMS', 'PUSH') NOT NULL,

    subject VARCHAR(255),
    message_template TEXT NOT NULL,

    is_active BOOLEAN DEFAULT TRUE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================
-- 7. NOTIFICATIONS
-- Main notification table
-- ============================================

CREATE TABLE notifications (
    notification_id BIGINT AUTO_INCREMENT PRIMARY KEY,

    customer_id BIGINT NOT NULL,
    template_id BIGINT,

    notification_type VARCHAR(50) NOT NULL,

    title VARCHAR(255),
    message TEXT NOT NULL,

    channel ENUM('EMAIL', 'SMS', 'PUSH') NOT NULL,

    priority ENUM('LOW', 'MEDIUM', 'HIGH', 'CRITICAL')
        DEFAULT 'MEDIUM',

    status ENUM(
        'PENDING',
        'PROCESSING',
        'SENT',
        'DELIVERED',
        'FAILED',
        'READ'
    ) DEFAULT 'PENDING',

    related_transaction_id BIGINT NULL,
    related_fraud_alert_id BIGINT NULL,
    related_settlement_id BIGINT NULL,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    sent_at TIMESTAMP NULL,
    delivered_at TIMESTAMP NULL,

    FOREIGN KEY (customer_id)
        REFERENCES customers(customer_id)
        ON DELETE CASCADE,

    FOREIGN KEY (template_id)
        REFERENCES notification_templates(template_id)
        ON DELETE SET NULL,

    FOREIGN KEY (related_transaction_id)
        REFERENCES transactions(transaction_id)
        ON DELETE SET NULL,

    FOREIGN KEY (related_fraud_alert_id)
        REFERENCES fraud_alerts(fraud_alert_id)
        ON DELETE SET NULL,

    FOREIGN KEY (related_settlement_id)
        REFERENCES settlement_transactions(settlement_transaction_id)
        ON DELETE SET NULL
);

-- ============================================
-- 8. NOTIFICATION DELIVERY LOGS
-- Stores notification delivery history
-- ============================================

CREATE TABLE notification_logs (
    log_id BIGINT AUTO_INCREMENT PRIMARY KEY,

    notification_id BIGINT NOT NULL,

    status ENUM(
        'CREATED',
        'QUEUED',
        'SENT',
        'DELIVERED',
        'FAILED',
        'READ'
    ) NOT NULL,

    failure_reason VARCHAR(500),

    logged_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (notification_id)
        REFERENCES notifications(notification_id)
        ON DELETE CASCADE
);

-- ============================================
-- 9. NOTIFICATION EVENTS
-- Stores banking events that trigger notifications
-- ============================================

CREATE TABLE notification_events (
    event_id BIGINT AUTO_INCREMENT PRIMARY KEY,

    customer_id BIGINT NOT NULL,

    event_type VARCHAR(100) NOT NULL,

    event_source VARCHAR(100) NOT NULL,

    reference_id BIGINT NULL,

    event_data JSON,

    processed BOOLEAN DEFAULT FALSE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (customer_id)
        REFERENCES customers(customer_id)
        ON DELETE CASCADE
);

-- ============================================
-- INDEXES FOR FASTER SEARCHING
-- ============================================

CREATE INDEX idx_notifications_customer
ON notifications(customer_id);

CREATE INDEX idx_notifications_status
ON notifications(status);

CREATE INDEX idx_notifications_created
ON notifications(created_at);

CREATE INDEX idx_notification_events_customer
ON notification_events(customer_id);

CREATE INDEX idx_notification_logs_notification
ON notification_logs(notification_id);

CREATE INDEX idx_transactions_status
ON transactions(transaction_status);

CREATE INDEX idx_risk_scores_level
ON transaction_risk_scores(risk_level);

CREATE INDEX idx_fraud_alerts_status
ON fraud_alerts(status);

CREATE INDEX idx_settlement_transactions_status
ON settlement_transactions(status);

