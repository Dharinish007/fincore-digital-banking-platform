# ============================================================================
# FinCore Digital Banking Platform - Environment Variables Template
# Copy this file to .env and adjust values for your local environment
# ============================================================================

# Backend Port
SERVER_PORT=8080

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/digital_banking?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=root

# AI Biometric Microservice (Python FastAPI)
OCR_SERVICE_URL=http://localhost:8000
LIVENESS_SERVICE_URL=http://localhost:8000

# Frontend Environment (Angular)
API_BASE_URL=http://localhost:8080
