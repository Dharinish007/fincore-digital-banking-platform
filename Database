-- FinCore Banking System
-- PostgreSQL SQL Script
-- Modules: Liveness Detection, Risk Assessment, Audit Logging
-- Includes table creation, indexes, sample/input data, views and useful queries.

-- =========================================================
-- 1. CLEANUP
-- =========================================================

DROP VIEW IF EXISTS high_risk_transactions;
DROP VIEW IF EXISTS recent_audit_activity;

DROP TABLE IF EXISTS audit_logs CASCADE;
DROP TABLE IF EXISTS risk_assessment CASCADE;
DROP TABLE IF EXISTS liveness_detection CASCADE;

-- =========================================================
-- 2. LIVENESS DETECTION
-- =========================================================
-- Stores the result and metadata of a liveness/identity check.
-- Do NOT store raw biometric images in this table.

CREATE TABLE liveness_detection (
    liveness_id BIGSERIAL PRIMARY KEY,
    customer_id BIGINT NOT NULL,
    session_id VARCHAR(100) NOT NULL,
    verification_type VARCHAR(30) NOT NULL DEFAULT 'FACE',
    verification_status VARCHAR(20) NOT NULL,
    confidence_score NUMERIC(5,2),
    attempt_number INTEGER NOT NULL DEFAULT 1,
    device_id VARCHAR(150),
    ip_address INET,
    failure_reason VARCHAR(255),
    verified_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT chk_liveness_type
        CHECK (verification_type IN ('FACE', 'VIDEO', 'BIOMETRIC')),

    CONSTRAINT chk_liveness_status
        CHECK (verification_status IN ('PASSED', 'FAILED', 'PENDING')),

    CONSTRAINT chk_confidence
        CHECK (confidence_score IS NULL OR
               confidence_score BETWEEN 0 AND 100),

    CONSTRAINT chk_attempt
        CHECK (attempt_number > 0)
);

CREATE INDEX idx_liveness_customer
    ON liveness_detection(customer_id);

CREATE INDEX idx_liveness_status
    ON liveness_detection(verification_status);

CREATE INDEX idx_liveness_verified_at
    ON liveness_detection(verified_at);

-- =========================================================
-- 3. RISK ASSESSMENT
-- =========================================================
-- Stores the calculated risk score and reason for a transaction.

CREATE TABLE risk_assessment (
    risk_id BIGSERIAL PRIMARY KEY,
    transaction_id BIGINT NOT NULL,
    customer_id BIGINT NOT NULL,
    risk_score NUMERIC(5,2) NOT NULL,
    risk_level VARCHAR(20) NOT NULL,
    risk_reason VARCHAR(500) NOT NULL,
    assessment_status VARCHAR(30) NOT NULL DEFAULT 'COMPLETED',
    assessed_by VARCHAR(100) DEFAULT 'FRAUD-DETECTION-SERVICE',
    assessed_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT chk_risk_score
        CHECK (risk_score BETWEEN 0 AND 100),

    CONSTRAINT chk_risk_level
        CHECK (risk_level IN ('LOW', 'MEDIUM', 'HIGH', 'CRITICAL')),

    CONSTRAINT chk_assessment_status
        CHECK (assessment_status IN ('PENDING', 'COMPLETED', 'REVIEW_REQUIRED'))
);

CREATE INDEX idx_risk_transaction
    ON risk_assessment(transaction_id);

CREATE INDEX idx_risk_customer
    ON risk_assessment(customer_id);

CREATE INDEX idx_risk_level
    ON risk_assessment(risk_level);

CREATE INDEX idx_risk_assessed_at
    ON risk_assessment(assessed_at);

-- =========================================================
-- 4. AUDIT LOGGING
-- =========================================================
-- Records important user/system actions for traceability.

CREATE TABLE audit_logs (
    audit_id BIGSERIAL PRIMARY KEY,
    user_id BIGINT,
    username VARCHAR(100),
    action VARCHAR(100) NOT NULL,
    entity_type VARCHAR(100),
    entity_id VARCHAR(100),
    description TEXT,
    old_value JSONB,
    new_value JSONB,
    ip_address INET,
    device_id VARCHAR(150),
    service_name VARCHAR(100),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_audit_user
    ON audit_logs(user_id);

CREATE INDEX idx_audit_action
    ON audit_logs(action);

CREATE INDEX idx_audit_entity
    ON audit_logs(entity_type, entity_id);

CREATE INDEX idx_audit_created_at
    ON audit_logs(created_at);

