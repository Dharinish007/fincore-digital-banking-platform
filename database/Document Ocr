-- =====================================================================
-- FinCore Digital Banking Platform — Document OCR Service Schema (PostgreSQL)
-- Milestone 4: Document Upload | OCR Extraction | Document Verification
--
-- Runs against the SAME shared database as the other services
-- (fincore_database_postgres.sql):
--   spring.datasource.url=jdbc:postgresql://localhost:5432/BankingApp
--   spring.datasource.username=postgres
--   spring.datasource.password=1998
--
-- PREREQUISITE: run fincore_database_postgres.sql first (customers
-- table must already exist — document_upload references it with a
-- real foreign key).
--
-- SETUP:
--   psql -U postgres -d BankingApp -f fincore_document_ocr_postgres.sql
-- =====================================================================

\c BankingApp

DROP TABLE IF EXISTS document_verification CASCADE;
DROP TABLE IF EXISTS ocr_result CASCADE;
DROP TABLE IF EXISTS document_upload CASCADE;

-- ───────────────────────────── DOCUMENT UPLOAD ─────────────────────────────
CREATE TABLE document_upload (
    document_id       BIGSERIAL PRIMARY KEY,
    customer_id       BIGINT NOT NULL REFERENCES customers(customer_id),

    document_type     VARCHAR(20) NOT NULL
                       CHECK (document_type IN ('PAN','AADHAAR','PASSPORT','VOTER_ID','DRIVING_LICENSE','BANK_STATEMENT','SALARY_SLIP')),

    file_name         VARCHAR(255) NOT NULL,
    file_path         VARCHAR(500) NOT NULL,     -- storage location (e.g. S3 key or local path)
    file_size_kb      INT CHECK (file_size_kb > 0),
    mime_type         VARCHAR(50),

    upload_status     VARCHAR(20) NOT NULL DEFAULT 'UPLOADED'
                       CHECK (upload_status IN ('UPLOADED','PROCESSING','PROCESSED','FAILED')),

    uploaded_at       TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_document_customer ON document_upload(customer_id);
CREATE INDEX idx_document_type ON document_upload(document_type);
CREATE INDEX idx_document_status ON document_upload(upload_status);

-- ───────────────────────────── OCR RESULT ─────────────────────────────
-- One row per OCR attempt - a document can be re-processed if the first
-- attempt fails or comes back low-confidence, so this is 1:N, not 1:1.
CREATE TABLE ocr_result (
    ocr_id              BIGSERIAL PRIMARY KEY,
    document_id         BIGINT NOT NULL REFERENCES document_upload(document_id),

    extracted_name      VARCHAR(150),
    extracted_dob       DATE,
    extracted_id_number VARCHAR(50),
    extracted_address   VARCHAR(255),
    extracted_gender    VARCHAR(10),
    issue_date          DATE,
    expiry_date         DATE,

    confidence_score    DECIMAL(5,2) CHECK (confidence_score BETWEEN 0 AND 100),
    ocr_engine          VARCHAR(30) NOT NULL DEFAULT 'TESSERACT'
                        CHECK (ocr_engine IN ('TESSERACT','GOOGLE_VISION','AWS_TEXTRACT','AZURE_OCR')),
    processing_time_ms  INT,

    status              VARCHAR(20) NOT NULL DEFAULT 'SUCCESS'
                        CHECK (status IN ('SUCCESS','LOW_CONFIDENCE','FAILED')),

    processed_at        TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_ocr_document ON ocr_result(document_id);
CREATE INDEX idx_ocr_status ON ocr_result(status);

-- ───────────────────────────── DOCUMENT VERIFICATION ─────────────────────────────
-- Compares OCR output against the customer's declared profile
-- (customers.first_name/last_name/date_of_birth) and produces a decision.
CREATE TABLE document_verification (
    verification_id       BIGSERIAL PRIMARY KEY,
    document_id           BIGINT NOT NULL REFERENCES document_upload(document_id),

    verification_status   VARCHAR(20) NOT NULL DEFAULT 'PENDING'
                          CHECK (verification_status IN ('PENDING','VERIFIED','REJECTED','MANUAL_REVIEW')),

    name_match_score      DECIMAL(5,2) CHECK (name_match_score BETWEEN 0 AND 100),
    dob_match              BOOLEAN,

    verified_by            VARCHAR(50) NOT NULL DEFAULT 'SYSTEM',
    remarks                 VARCHAR(255),

    verified_at             TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_verification_document ON document_verification(document_id);
CREATE INDEX idx_verification_status ON document_verification(verification_status);

