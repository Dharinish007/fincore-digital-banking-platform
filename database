-- ============================================
-- VIEW ALL CUSTOMER NOTIFICATIONS
-- ============================================

SELECT
    n.notification_id,
    c.full_name,
    n.notification_type,
    n.title,
    n.message,
    n.channel,
    n.priority,
    n.status,
    n.created_at
FROM notifications n
JOIN customers c
    ON n.customer_id = c.customer_id
ORDER BY n.created_at DESC;

-- ============================================
-- VIEW FAILED NOTIFICATIONS
-- ============================================

SELECT
    n.notification_id,
    c.full_name,
    n.notification_type,
    n.channel,
    n.status,
    n.created_at
FROM notifications n
JOIN customers c
    ON n.customer_id = c.customer_id
WHERE n.status = 'FAILED';

-- ============================================
-- VIEW FRAUD ALERT NOTIFICATIONS
-- ============================================

SELECT
    notification_id,
    customer_id,
    title,
    message,
    priority,
    status,
    created_at
FROM notifications
WHERE notification_type = 'FRAUD_ALERT';

-- ============================================
-- 8. BALANCE, STATEMENT AND LOAN OPERATIONS
-- ============================================

CREATE TABLE customers (
    customer_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    full_name VARCHAR(150) NOT NULL,
    email VARCHAR(255) NOT NULL UNIQUE,
    phone_number VARCHAR(30) NOT NULL,
    account_number VARCHAR(30),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE account_statements (
    statement_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    account_id BIGINT NOT NULL,
    reference VARCHAR(100) NOT NULL UNIQUE,
    entry_type ENUM('CREDIT', 'DEBIT') NOT NULL,
    amount DECIMAL(18,2) NOT NULL,
    balance_after DECIMAL(18,2) NOT NULL,
    description VARCHAR(255),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (account_id) REFERENCES accounts(account_id)
);

CREATE TABLE loan_schedules (
    schedule_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    loan_id BIGINT NOT NULL,
    installment_number INT NOT NULL,
    due_date DATE NOT NULL,
    principal_due DECIMAL(18,2) NOT NULL,
    interest_due DECIMAL(18,2) NOT NULL,
    total_due DECIMAL(18,2) NOT NULL,
    status ENUM('PENDING', 'PAID', 'OVERDUE') DEFAULT 'PENDING',
    paid_at TIMESTAMP NULL
);

CREATE TABLE loan_disbursements (
    disbursement_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    loan_id BIGINT NOT NULL,
    amount DECIMAL(18,2) NOT NULL,
    channel ENUM('NEFT', 'RTGS', 'IMPS') NOT NULL,
    reference VARCHAR(100) NOT NULL UNIQUE,
    status ENUM('PENDING', 'COMPLETED', 'FAILED') DEFAULT 'COMPLETED',
    disbursed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE loan_collections (
    collection_id BIGINT AUTO_INCREMENT PRIMARY KEY,
    loan_id BIGINT NOT NULL,
    schedule_id BIGINT,
    amount DECIMAL(18,2) NOT NULL,
    channel ENUM('AUTO_DEBIT', 'UPI', 'NEFT', 'CASH') NOT NULL,
    reference VARCHAR(100) NOT NULL UNIQUE,
    status ENUM('RECEIVED', 'FAILED', 'REVERSED') DEFAULT 'RECEIVED',
    collected_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (schedule_id) REFERENCES loan_schedules(schedule_id)
);
```

## Database Flow

```text
Banking Event
     ↓
notification_events
     ↓
Check notification_preferences
     ↓
notification_templates
     ↓
notifications
     ↓
SMS / EMAIL / PUSH
     ↓
notification_logs
```

### Tables and Purpose

| Table                      | Purpose                                          |
| -------------------------- | ------------------------------------------------ |
| `customers`                | Stores customer details                          |
| `notification_preferences` | Stores customer notification settings            |
| `notification_templates`   | Stores reusable message templates                |
| `notifications`            | Stores generated notifications                   |
| `notification_logs`        | Tracks delivery status and failures              |
| `notification_events`      | Stores banking events that trigger notifications |

> **Designed and implemented the Notification Service database for the Banking Service Management System. The database manages customer notification preferences, notification templates, banking events, generated alerts, delivery status, and notification history. Primary keys, foreign keys, constraints, indexes, and logs were used to maintain data integrity and support efficient notification processing.**
