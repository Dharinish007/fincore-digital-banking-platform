-- =========================================================
-- 8. USEFUL VIEWS
-- =========================================================

CREATE OR REPLACE VIEW high_risk_transactions AS
SELECT
    risk_id,
    transaction_id,
    customer_id,
    risk_score,
    risk_level,
    risk_reason,
    assessment_status,
    assessed_at
FROM risk_assessment
WHERE risk_level IN ('HIGH', 'CRITICAL')
ORDER BY risk_score DESC;

CREATE OR REPLACE VIEW recent_audit_activity AS
SELECT
    audit_id,
    user_id,
    username,
    action,
    entity_type,
    entity_id,
    description,
    service_name,
    created_at
FROM audit_logs
ORDER BY created_at DESC;

-- =========================================================
-- 9. DEMONSTRATION QUERIES
-- =========================================================

-- View all liveness records
SELECT * FROM liveness_detection
ORDER BY verified_at DESC;

-- View only successful liveness checks
SELECT customer_id, session_id, confidence_score, verified_at
FROM liveness_detection
WHERE verification_status = 'PASSED'
ORDER BY confidence_score DESC;

-- Find customers with failed liveness attempts
SELECT customer_id, COUNT(*) AS failed_attempts
FROM liveness_detection
WHERE verification_status = 'FAILED'
GROUP BY customer_id
ORDER BY failed_attempts DESC;

-- View all risk assessments
SELECT *
FROM risk_assessment
ORDER BY risk_score DESC;

-- View high and critical risk transactions
SELECT *
FROM high_risk_transactions;

-- Count transactions by risk level
SELECT risk_level, COUNT(*) AS transaction_count
FROM risk_assessment
GROUP BY risk_level
ORDER BY transaction_count DESC;

-- Find transactions requiring review
SELECT transaction_id, customer_id, risk_score,
       risk_level, risk_reason
FROM risk_assessment
WHERE assessment_status = 'REVIEW_REQUIRED'
ORDER BY risk_score DESC;

-- View audit history for Rahul
SELECT audit_id, action, entity_type, entity_id,
       description, service_name, created_at
FROM audit_logs
WHERE user_id = 101
ORDER BY created_at DESC;

-- View all fraud-related audit events
SELECT *
FROM audit_logs
WHERE action LIKE '%FRAUD%'
ORDER BY created_at DESC;

-- View the latest 20 audit records
SELECT *
FROM audit_logs
ORDER BY created_at DESC
LIMIT 20;
