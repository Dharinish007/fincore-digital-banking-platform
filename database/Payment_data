DROP TABLE IF EXISTS payment_transaction CASCADE;
DROP TABLE IF EXISTS beneficiary CASCADE;

-- ───────────────────────────── BENEFICIARY ─────────────────────────────
CREATE TABLE beneficiary (
    beneficiary_id     BIGSERIAL PRIMARY KEY,
    customer_id        BIGINT NOT NULL REFERENCES customers(customer_id),

    beneficiary_name   VARCHAR(150) NOT NULL,
    account_number     VARCHAR(30)  NOT NULL,
    ifsc_code          VARCHAR(11)  NOT NULL,
    bank_name          VARCHAR(100) NOT NULL,
    nickname           VARCHAR(50),

    status             VARCHAR(20)  NOT NULL DEFAULT 'ACTIVE'
                        CHECK (status IN ('ACTIVE','INACTIVE','BLOCKED')),

    added_date         DATE NOT NULL DEFAULT CURRENT_DATE,

    UNIQUE (customer_id, account_number)   -- can't add the same payee account twice
);

CREATE INDEX idx_beneficiary_customer ON beneficiary(customer_id);

-- ───────────────────────────── PAYMENT TRANSACTION ─────────────────────────────
CREATE TABLE payment_transaction (
    transaction_id       BIGSERIAL PRIMARY KEY,
    from_account_id       BIGINT NOT NULL REFERENCES accounts(account_id),
    beneficiary_id         BIGINT REFERENCES beneficiary(beneficiary_id),  -- NULL for self/internal transfers

    amount                  DECIMAL(15,2) NOT NULL CHECK (amount > 0),
    transaction_mode         VARCHAR(10) NOT NULL
                              CHECK (transaction_mode IN ('IMPS','NEFT','UPI')),
    transaction_status        VARCHAR(20) NOT NULL DEFAULT 'INITIATED'
                              CHECK (transaction_status IN ('INITIATED','SUCCESS','FAILED','PENDING')),

    reference_number           VARCHAR(30) NOT NULL UNIQUE,
    remarks                     VARCHAR(255),

    initiated_at                 TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    completed_at                 TIMESTAMP
);

CREATE INDEX idx_txn_from_account ON payment_transaction(from_account_id);
CREATE INDEX idx_txn_beneficiary ON payment_transaction(beneficiary_id);
CREATE INDEX idx_txn_mode ON payment_transaction(transaction_mode);
CREATE INDEX idx_txn_status ON payment_transaction(transaction_status);

-- ───────────────────────────── UPI MAPPING ─────────────────────────────
CREATE TABLE upi_mapping (
    upi_id              BIGSERIAL PRIMARY KEY,
    customer_id         BIGINT NOT NULL REFERENCES customers(customer_id),
    linked_account_id   BIGINT NOT NULL REFERENCES accounts(account_id),

    vpa                 VARCHAR(50) NOT NULL UNIQUE,   -- e.g. arun.kumar@fincore
    status               VARCHAR(20) NOT NULL DEFAULT 'ACTIVE'
                          CHECK (status IN ('ACTIVE','INACTIVE')),

    linked_at             TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_upi_customer ON upi_mapping(customer_id);

